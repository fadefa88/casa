# Intervallo minimo supportato dal monitor: 30 secondi.
CHECK_INTERVAL_SECONDS=45
REQUEST_TIMEOUT_SECONDS=8

# Provider interrogati in ordine finché uno risponde.
IP_PROVIDERS=https://api.ipify.org,https://ifconfig.me/ip,https://icanhazip.com

# Classificazione consigliata tramite ASN del prefisso pubblico.
# Dimensione: AS202870. WINDTRE: AS1267 e AS24608.
PRIMARY_ASNS=202870
BACKUP_ASNS=1267,24608

# Regole opzionali più restrittive: IP singoli o reti CIDR separati da virgola.
# Le reti CIDR, quando presenti, hanno precedenza sulla classificazione ASN.
# PRIMARY_IP_NETWORKS=185.152.44.0/22
# BACKUP_IP_NETWORKS=91.254.0.0/16
PRIMARY_IP_NETWORKS=
BACKUP_IP_NETWORKS=

# Endpoint RIPEstat usato dal mini-PC per ricavare prefisso e ASN dell'IP pubblico.
NETWORK_INFO_URL=https://stat.ripe.net/data/network-info/data.json?resource={ip}

# Fallback: se né reti né ASN permettono di classificare l'IP, il primo IP
# rilevato viene memorizzato come primario. Con gli ASN sopra normalmente
# questo meccanismo non viene utilizzato.
AUTO_LEARN_PRIMARY=true

LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
CORS_ORIGIN=*
DATA_DIR=/var/lib/casa-network-monitor
LOG_LEVEL=INFO
