# Intervallo minimo supportato dal monitor: 30 secondi.
CHECK_INTERVAL_SECONDS=45
REQUEST_TIMEOUT_SECONDS=8

# Provider interrogati in ordine finché uno risponde.
IP_PROVIDERS=https://api.ipify.org,https://ifconfig.me/ip,https://icanhazip.com

# Inserire IP singoli o reti CIDR separati da virgola quando disponibili.
# Esempi:
# PRIMARY_IP_NETWORKS=203.0.113.24/32,203.0.113.0/24
# BACKUP_IP_NETWORKS=198.51.100.0/24
PRIMARY_IP_NETWORKS=
BACKUP_IP_NETWORKS=

# Se non vengono configurate reti, il primo IP rilevato viene memorizzato come FTTH.
# Un IP successivo differente viene classificato come backup 5G.
AUTO_LEARN_PRIMARY=true

LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
CORS_ORIGIN=*
DATA_DIR=/var/lib/casa-network-monitor
LOG_LEVEL=INFO
